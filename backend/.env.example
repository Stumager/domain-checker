HOST=127.0.0.1
PORT=8080
DEBUG=False
# SECRET_KEY=your-secret-key-here  (auto-generated on each start if not set)
CORS_ORIGINS=
MAX_DOMAINS=200000

FINAL_CHECK_ENABLED=1
FINAL_CHECK_WORKERS=20
RDAP_TIMEOUT=7.0
RDAP_RETRIES=2
DEFAULT_TLDS=es it pl fr de pt nl be se fi no dk tr in ca br mx co
DNS_PREFILTER_STRICT_TLDS=com in co mx vn

# Per-TLD RDAP concurrency caps (JSON) — lower values reduce 429 rate-limit errors
# RDAP_CONCURRENCY_OVERRIDES={"de": 3, "es": 2, "it": 4, "br": 4, "in": 6}

# Per-TLD RDAP endpoint overrides (JSON) — bypass bootstrap for known endpoints
# RDAP_TLD_OVERRIDES={"de": "https://rdap.denic.de/", "es": "https://rdap.nic.es/rdap/"}

BROWSER_MONITOR_ENABLED=1
BROWSER_MONITOR_TIMEOUT=60
BROWSER_MONITOR_STARTUP_GRACE=30
BROWSER_MONITOR_SHUTDOWN_DELAY=3
AUTO_OPEN_BROWSER=1

# Groq LLM semantic classifier (optional — leave blank to disable)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=8
# Snapshots to analyze per domain, evenly distributed across time range (25 RPM free tier)
# 60 = ~2.5 min | 100 = ~4 min | 0 = disable Groq
GROQ_SNAPSHOT_MAX=60

# Auth — seeded on first run if no users exist yet. Change the password after login.
SEED_ADMIN_EMAIL=admin@checker.local
SEED_ADMIN_PASSWORD=admin123
# SQLite file for Maps tables + users. Empty = backend/data/maps.db
MAPS_DB_PATH=

# Maps Scraper — requires `docker compose up -d` from the project root (see README)
GMAPS_API_URL=http://localhost:8090
GMAPS_TIMEOUT=20
GMAPS_DOWNLOAD_TIMEOUT=120
GMAPS_POLL_INTERVAL=30
GMAPS_MAX_TIME=600
GMAPS_DEFAULT_DEPTH=10
GMAPS_DEFAULT_ZOOM=15
GMAPS_DEFAULT_CONCURRENCY=4
GMAPS_DEFAULT_GRID_CELL=1.0

# Nominatim — required User-Agent per their usage policy, do not remove
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=DomainChecker/1.0
NOMINATIM_TIMEOUT=15

# Proxy checking (Maps tab "Check All")
PROXY_CHECK_URL=https://www.google.com
PROXY_CHECK_TIMEOUT=10
PROXY_CHECK_WORKERS=8
